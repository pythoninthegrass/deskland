# Copy to .env at the repo root. Names match ~/git/megabonk_mods so one .env and keychain profile serve both.
# Developer ID Application identity in the login keychain (security find-identity -v -p codesigning). Unset signs ad-hoc.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# notarytool keychain profile (xcrun notarytool store-credentials). Wins over the API key below.
# NOTARY_PROFILE=
# App Store Connect API key: key ID, issuer UUID, and the base64 of the .p8 (openssl base64 -A -in AuthKey_XXXXXXXXXX.p8)
# APPLE_API_KEY=
# APPLE_API_ISSUER=
# APPLE_API_KEY_B64=
